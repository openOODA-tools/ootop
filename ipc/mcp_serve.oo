// # MCP Stdio Server - System Telemetry Protocol Surface
//
// Logline: Speaks Model Context Protocol over stdio providing system metrics and process inspection.
//
// Setup: Bound to FsReadCap and EnvCap. Handles system_metrics, process_list, and systemd_slices.
//
// Beats:
//   1. Handle initialize and notifications/initialized lifecycle handshakes.
//   2. Advertise telemetry and process tools with JSON schemas.
//   3. Dispatch tool execution requests and return structured JSON metrics.

import "proc/cpu_stat.oo";
import "proc/mem_stat.oo";
import "proc/disk_stat.oo";
import "proc/net_stat.oo";
import "proc/proc_list.oo";
import "systemd/slice_group.oo";
import "json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
}

fn handle_tool_call(fs: &FsReadCap, id: String, req: String) -> String {
    let params: String = json_field_raw(req, "params");
    let tool_name: String = json_field_string(params, "name");

    if tool_name == "system_metrics" {
        let cpu: CpuOverview = read_cpu_overview(fs);
        let mem: MemStat = read_mem_stat(fs);
        let disk: DiskStat = read_disk_stat(fs);
        let net: NetStat = read_net_stat(fs);

        let mut res: String = "{\n";
        res = res + "  \"cpu\": {\"percent\": " + to_string(cpu.percent) + ", \"cores\": " + to_string(cpu.cores) + "},\n";
        res = res + "  \"memory\": {\"total_mib\": " + to_string(mem.mem_total_mib) + ", \"used_mib\": " + to_string(mem.mem_used_mib) + ", \"percent\": " + to_string(mem.mem_percent) + "},\n";
        res = res + "  \"swap\": {\"total_mib\": " + to_string(mem.swap_total_mib) + ", \"used_mib\": " + to_string(mem.swap_used_mib) + ", \"percent\": " + to_string(mem.swap_percent) + "},\n";
        res = res + "  \"disk\": {\"read_mib\": " + to_string(disk.read_mib) + ", \"write_mib\": " + to_string(disk.write_mib) + ", \"iops\": " + to_string(disk.io_operations) + "},\n";
        res = res + "  \"network\": {\"rx_mib\": " + to_string(net.rx_mib) + ", \"tx_mib\": " + to_string(net.tx_mib) + "}\n";
        res = res + "}\n";
        return build_tool_result(id, res);
    }

    if tool_name == "process_list" {
        let procs: List[ProcEntry] = collect_top_processes(fs, 15);
        let n: Int = list_len(procs);
        let mut res: String = "[\n";
        let mut i: Int = 0;
        while i < n {
            let p: ProcEntry = list_get(procs, i);
            res = res + "  {\"pid\": " + to_string(p.pid) + ", \"comm\": \"" + json_escape(p.comm) + "\", \"rss_mib\": " + to_string(p.rss_mib) + ", \"slice\": \"" + json_escape(p.slice) + "\"}";
            if i + 1 < n { res = res + ","; }
            res = res + "\n";
            i = i + 1;
        }
        res = res + "]\n";
        return build_tool_result(id, res);
    }

    if tool_name == "systemd_slices" {
        let procs: List[ProcEntry] = collect_top_processes(fs, 50);
        let s: SliceReport = aggregate_slices(procs);
        let mut res: String = "{\n";
        res = res + "  \"system_slice\": {\"tasks\": " + to_string(s.system_slice.task_count) + ", \"rss_mib\": " + to_string(s.system_slice.rss_mib) + "},\n";
        res = res + "  \"user_slice\": {\"tasks\": " + to_string(s.user_slice.task_count) + ", \"rss_mib\": " + to_string(s.user_slice.rss_mib) + "},\n";
        res = res + "  \"app_slice\": {\"tasks\": " + to_string(s.app_slice.task_count) + ", \"rss_mib\": " + to_string(s.app_slice.rss_mib) + "},\n";
        res = res + "  \"other_slice\": {\"tasks\": " + to_string(s.other_slice.task_count) + ", \"rss_mib\": " + to_string(s.other_slice.rss_mib) + "}\n";
        res = res + "}\n";
        return build_tool_result(id, res);
    }

    return build_error(id, -32601, "unknown tool: " + tool_name);
}

fn handle_mcp_request(fs: &FsReadCap, req: String) -> String {
    let method: String = json_field_string(req, "method");
    let raw_id: String = json_field_raw(req, "id");
    let id: String = if chars_len(raw_id) == 0 { "null" } else { raw_id };

    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"ootop\",\"version\":\"0.1.0\"}}}";
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[{\"name\":\"system_metrics\",\"description\":\"Return current CPU, memory, swap, disk, and network telemetry\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},{\"name\":\"process_list\",\"description\":\"Return active running processes sorted by memory footprint\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}},{\"name\":\"systemd_slices\",\"description\":\"Return task and memory aggregation by systemd slice\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}]}}";
    }
    if method == "tools/call" {
        return handle_tool_call(fs, id, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}";
    }
    return build_error(id, -32601, "method not found: " + method);
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = str_index_of(buf, "\n");
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let reply: String = handle_mcp_request(fs, trimmed);
                        if chars_len(reply) > 0 {
                            println(reply);
                        }
                    }
                    nl_pos = str_index_of(buf, "\n");
                }
            }
        }
    }
    return 0;
}
