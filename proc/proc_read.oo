// # Proc Reader - Virtual Filesystem Ingestion Primitives
//
// Logline: Ingests virtual /proc text streams and provides structured line and token parsing.
//
// Setup: Requires FsReadCap. Leverages file_reader_open and file_reader_read_all.
//
// Beats:
//   1. Ingest virtual filesystem payloads through streaming file readers.
//   2. Parse integer values robustly from space-padded text representations.
//   3. Tokenize lines into whitespace-delimited word sequences.

import "std/fs/file/file_reader.oo";

pub fn read_proc_text(fs: &FsReadCap, path: String) -> String {
    let r_open: Result[FileReader, String] = file_reader_open(fs, path);
    if r_open.is_err() { return ""; }
    let reader: FileReader = match r_open { Ok(r) => r, Err(_) => return "" };
    let r_read: Result[String, String] = file_reader_read_all(fs, reader);
    return match r_read { Ok(s) => s, Err(_) => "" };
}

fn digit_val(c: String) -> Int {
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    return 0;
}

pub fn parse_proc_int(s: String) -> Int {
    let t: String = str_trim(s);
    let n: Int = chars_len(t);
    let mut i: Int = 0;
    let mut neg: Bool = false;
    while i < n {
        let c: String = char_at(t, i);
        if c == "-" {
            neg = true;
            i = i + 1;
            break;
        } else if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            break;
        }
        i = i + 1;
    }
    let mut v: Int = 0;
    while i < n {
        let c: String = char_at(t, i);
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            v = v * 10 + digit_val(c);
        } else if v > 0 {
            break;
        }
        i = i + 1;
    }
    if neg { return 0 - v; }
    return v;
}

pub fn split_proc_lines(content: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            lines = list_push(lines, cur);
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        lines = list_push(lines, cur);
    }
    return lines;
}

pub fn split_proc_words(line: String) -> List[String] {
    let mut words: List[String] = list_new();
    let n: Int = chars_len(line);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == " " || c == "\t" {
            if cur != "" {
                words = list_push(words, cur);
                cur = "";
            }
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        words = list_push(words, cur);
    }
    return words;
}

pub fn read_proc_loadavg(fs: &FsReadCap) -> List[String] {
    let content: String = read_proc_text(fs, "/proc/loadavg");
    let words: List[String] = split_proc_words(content);
    let mut out: List[String] = list_new();
    let l1: String = if list_len(words) > 0 { list_get(words, 0) } else { "0.00" };
    let l5: String = if list_len(words) > 1 { list_get(words, 1) } else { "0.00" };
    let l15: String = if list_len(words) > 2 { list_get(words, 2) } else { "0.00" };
    out = list_push(out, l1);
    out = list_push(out, l5);
    out = list_push(out, l15);
    return out;
}

pub fn read_proc_uptime_seconds(fs: &FsReadCap) -> Int {
    let content: String = read_proc_text(fs, "/proc/uptime");
    let words: List[String] = split_proc_words(content);
    if list_len(words) == 0 { return 0; }
    let up_str: String = list_get(words, 0);
    let dot_pos: Int = str_index_of(up_str, ".");
    let int_str: String = if dot_pos > 0 { str_slice(up_str, 0, dot_pos) } else { up_str };
    return parse_proc_int(int_str);
}

